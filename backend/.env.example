# ==============================================================================
# Inpatient Management / AI Chatbot Platform Backend Configuration
# Copy this file to .env and provide secure production values.
# NEVER commit the actual .env file or real secrets to source control.
# ==============================================================================

# Server
PORT=8080

# Database
DATABASE_URL=jdbc:mysql://localhost:3306/chatbot_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DATABASE_USERNAME=root
DATABASE_PASSWORD=your_secure_database_password_here
DB_POOL_MAX=20
DB_POOL_MIN_IDLE=5

# JWT Authentication
# The secret must be a cryptographically secure string of at least 256 bits (32 bytes), e.g. 64 hex chars or base64.
JWT_SECRET=your_minimum_256_bit_cryptographically_secure_hex_encoded_secret_key_here
# Access token expiration in milliseconds (e.g. 900000 = 15 minutes)
JWT_EXPIRATION_MS=900000

# CORS Allowed Origins (comma-separated list of allowed frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# AI Defaults (Provider-agnostic abstraction)
AI_DEFAULT_PROVIDER=OLLAMA
AI_DEFAULT_MODEL=llama3.2:3b
AI_OLLAMA_BASE_URL=http://localhost:11434
AI_OLLAMA_API_KEY=your_optional_ollama_api_key_here
